<div class="row">
  <% blank_forms && blank_forms.each do | form | %>
    <%= link_to show_blank_forms_path(form.department.eng_name,form.id), class:"col-md-3 anchor-no-decoration" do %>
      <center>
        <div class="card" style="width: 180px; border-radius: 0px;border: 2px solid blue;border-radius: 5px;  ">
          <div class="card-body p-2" style="border-bottom: 2px solid blue; min-height:100px;">
            <div class="card-text fnt-14 fnt-b txt-center"><%= form.eng_name.camelize %> / <%= form.hindi_name %></div>
            <div class="card-text fnt-14 fnt-b txt-center">(<%= form.section.capitalize %>)</div>
          </div>
          <img src="/assets/letter_img.png" class="card-img-top" alt="..."  >
        </div>
      </center>
    <% end %>
  <% end %>
</div>
<div class="row">
  <div class="col-md-4"></div>
  <div class="col-md-4">
    <%= paginate blank_forms %>
  </div>
  <div class="col-md-4"></div>
</div>