<div class="row" data-controller="misc">
  <div class="col-md-1"></div>
  <div class="col-md-10 mb-5" style="border-bottom: 1px solid lightgray;box-shadow:0px 12px 14px -13px #111">
    <div class="row">
      <div class="col-md-3"></div>
      <div class="col-md-6">
        <div data-controller="autocomplete" data-autocomplete-url-value="/welcome/autocomplete_term" >
          <div class="input-group mb-3">
            <input type="text" id="search_term" class="form-control" placeholder="Type here for search" data-autocomplete-target="input">
            <input type="hidden" name="form_id" data-autocomplete-target="hidden"/>
            <button type="button" class="input-group-text btn btn-primary" data-action="click->misc#searchForms">
              <i class="fas fa-search"></i>
            </button>
          </div>
          <ul class="list-group" data-autocomplete-target="results"></ul>
        </div>
      </div>
      <div class="col-md-3"></div>
    </div>
  </div>
  <div class="col-md-1"></div>
</div>
<div class="row mb-3">
  <div class="col-md-1"></div>
  <div class="col-md-10">
    <div id="forms-list">
      <%= render partial: "form_list", locals: {blank_forms: @blank_forms} %>
    </div>
  </div>
  <div class="col-md-1"></div>
</div>