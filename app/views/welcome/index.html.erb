<div class="row">
  <div class="col-md-1"></div>
  <div class="col-md-10 mb-5" style="border-bottom: 1px solid lightgray;box-shadow:0px 12px 14px -13px #111">
    <div class="row">
      <div class="col-md-3"></div>
      <div class="col-md-6">
        <div class="input-group mb-3">
          <input type="text" class="form-control" placeholder="Type here for search" aria-label="Type here for search" aria-describedby="basic-addon2">
          <button type="button" class="input-group-text btn btn-primary">
            <i class="fas fa-search"></i>
          </button>
        </div>
      </div>
      <div class="col-md-3"></div>
    </div>
  </div>
  <div class="col-md-1"></div>
</div>

<div class="row mb-3">
  <div class="col-md-1"></div>
  <div class="col-md-10">
    <div class="row" id="forms-block">
      <% @blank_forms && @blank_forms.each do | form | %>
        <%= link_to show_blank_forms_path(form.department.eng_name,form.id), class:"col-md-3 anchor-no-decoration" do %>
          <center>
            <div class="card" style="width: 180px; border-radius: 0px;border: 2px solid blue;border-radius: 5px;  ">
              <div class="card-body p-2" style="border-bottom: 2px solid blue; min-height:100px;">
                <div class="card-text fnt-14 fnt-b txt-center"><%= form.eng_name.camelize %> / <%= form.hindi_name %></div>
                <div class="card-text fnt-14 fnt-b txt-center">(<%= form.section.capitalize %>)</div>
              </div>
              <img src="/assets/letter_img.png" class="card-img-top" alt="..."  >
            </div>
          </center>
        <% end %>
      <% end %>
    </div>
    <div class="row">
      <div class="col-md-4"></div>
      <div class="col-md-4">
        <%= paginate @blank_forms %>
      </div>
      <div class="col-md-4"></div>
    </div>
  </div>
  <div class="col-md-1"></div>
</div>