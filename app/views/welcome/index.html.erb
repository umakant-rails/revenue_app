<div class="row" data-controller="misc">
  <div class="col-md-1"></div>
  <div class="col-md-10">
    <div class="row">
      <% @categories && @categories.each_with_index do |category| %>
        <div class="col-md-3">
          <% department = BlankForm.where("section_hindi=?", category).first.department %>
          <%= link_to section_blank_forms_path(department.eng_name, category), class: "text-decoration-none" do %>
            <div class="card l-bg-blue-dark">
              <div class="card-statistic-3 p-4">
                <div class="row align-items-center mb-2 d-flex">
                  <div class="col-12 widget-txt-box">
                    <h3 class="d-flex align-items-center mt-4">
                      <b><%= category %></b>
                    </h3>
                    <div class="card-icon card-icon-large mt-3"><i class="fas fa-file-alt"></i></div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="col-md-1"></div>
</div>