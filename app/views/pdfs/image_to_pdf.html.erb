<div class="row">
  <div class="col-md-2"></div>
  <div class="col-md-8">
 
    <div class="row fnt-30 fnt-b mb-5 page-sub-header" style="border-bottom: 1px solid lightgray;box-shadow:0px 12px 14px -13px red">
      <div class="fnt-30 text-center">JPG TO PDF</div>
    </div>

    <!-- <div class="row file-dropping-area" id="dropFiles">
      <input type="file" id="imageToPdf" name="myfile" class="file-upload"/>
    </div>
    <div class="row p-1 bdr-black" id="file-select-bottom-div" style="display:none;">
      <div class="col-md-2 ps-0">
        <input type="button" class="btn btn-primary" id="open-file-dialog-div" value="Select Image"/>
      </div>
      <div class="col-md-8"></div>
      <div class="col-md-2 p-0">
        <i class="fa-solid fa-trash fnt-22 pt-1 pe-2 text-white remove-selected-image"></i>
