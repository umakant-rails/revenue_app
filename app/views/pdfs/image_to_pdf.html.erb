    <input type="hidden" value="<%= form_authenticity_token %>" id="authenticity_token" />
    <div class="row before-file-container" id="dropFiles">
      <div class="file-dropping-area">
        <input type="file" id="imageToPdf" name="myfile" class="file-upload" style="display:none;"/>
        <div class="col-md-12 fnt-18 text-center mb-4 mt-4" style="color:gray;">
          Drop your images here to convert image into PDF
        </div>
        <div class="col-md-12 text-center">
          <button class="open-file-dialog1 file-upload-btn">
            Select Image
          </button>
        </div>
      </div>
    </div>
    <div class="file-processing-container" style="display: none;">
      <div class="row file-holding-sub-container justify-content-center">
        <div class="col-md-2">
          <div class="open-file-dialog1 new-file-selecter">
            <i class="fa-regular fa-square-plus fnt-24 text-secondary"></i>
            <div class="fnt-15 text-secondary">Add Image File</div>
          </div>
        </div>
      </div>
      <div class="row p-1 bdr-black">
        <div class="col-md-2 ps-0">
          <input type="button" class="btn btn-primary open-file-dialog1" id="open-file-dialog-div" value="Select Image"/>
        </div>
        <div class="col-md-8"></div>
        <div class="col-md-2 p-0">
          <i class="fa-solid fa-trash fnt-22 pt-1 pe-2 text-white remove-selected-image"></i>
          <input type="button" class="btn btn-primary fRight convert-image-to-pdf" value="Convert To Pdf"/>
        </div>
      </div>
    </div>

    <div class="row file-downloading-container justify-content-center" style="display: none;">
      <div class="col-md-12 fnt-18 text-center mt-4" style="color:gray;">
        Your PDF is ready for Download!
      </div>
      <div class="col-md-4 text-center">
        <div class="row">
          <div class="col-md-2">
            <i class="fa-solid fa-left-long fnt-28 backward-icon"></i>
          </div>
          <div class="col-md-8">
            <button class="file-download-btn form-control btn btn-primary btn-lg">
              <i class="fa-solid fa-download me-2"></i> Download File
            </button>
          </div>
          <div class="col-md-2">
            <i class="fa-solid fa-trash fnt-26 delete-pdf-icon"></i>
          </div>
        </div>
        <div class="col-md-12 fnt-15 text-center mt-4" id="file-size" style="color:gray;">
        </div>
      </div>
    </div>

  </div>
  <div class="col-md-2"></div>
</div>