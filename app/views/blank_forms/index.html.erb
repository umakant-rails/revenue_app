<div class="row">
  <div class="col-md-1"></div>
  <div class="col-md-3">
    <%= select_tag "form_name", options_from_collection_for_select(@blank_forms, "id", "hindi_name"), 
      class: "form-control", prompt: "Select Form" %>
    <div class="row">
      <div class="col-md-6">
        <input type="button" value="print" class="form-control btn btn-primary mt-2 print-btn" />
      </div>
      <div class="col-md-6" data-controller="blnk-frm">
        <button data-action="click->blnk-frm#downloadPDF" class="form-control btn btn-danger mt-2" />
          PDF&nbsp;&nbsp;<i class="fa-solid fa-file-export"></i>
        </button  >
      </div>
    </div>
  </div>
  <div class="col-md-7" id="blank-form-block">
    <%= render partial: "blank_forms/forms/pmkisan_letter" %>
    <%#= render partial: "blank_forms/forms/income_certificate_form" %>
    <%#= render partial: "blank_forms/forms/domicile_certificate_form" %>
  </div>
  <div class="col-md-1"></div>
</div>
<% content_for :head do %>
  <%= javascript_import_module_tag "custom/translate-custom" %>
<% end %>