<div class="row pt-4" data-controller="request blnk-frm">
  <div class="col-md-1"></div>
  <div class="col-md-3 not-print">
    <div class="row page-list">
      <div class="page-header">
        पेज की सूची
      </div>
      <ol class="list-group mb-4 pe-0 page-list" data-request-target="paymentstatus">
        <% @blank_forms && @blank_forms.each do | blank_form | %>
          <%= link_to show_blank_forms_path(params[:department], blank_form.id), class: "text-decoration-none" do %>
            <% active_cls = (blank_form.eng_name == @blank_form.eng_name) ? "active" : "" %>
            <li class="list-group-item <%= active_cls %>" data-action="click->request#showPage" data-pagename="request-page">
              <%= blank_form.hindi_name %>
            </li>
          <% end %>
        <% end %>
      </ol>
    </div>
    <div class="row">
      <div class="col-md-6">
        <input type="button" value="print" class="form-control btn btn-primary mt-2 print-btn" />
      </div>
      <div class="col-md-6">
        <button data-action="click->blnk-frm#downloadPDF" class="form-control btn btn-danger mt-2" />
          PDF&nbsp;&nbsp;<i class="fa-solid fa-file-export"></i>
        </button >
      </div>
    </div>
  </div>
  <div class="col-md-7 ms-5" data-controller="blnk-frm">
    <div id="page-block">
      <% if @blank_form.department.eng_name == "revenue" %>
        <div class="col-md-10" data-controller="misc">
          <div class="mb-3 row">
            <div class="col-md-3">
              <label class="form-label">District</label>
              <%= select_tag :district, options_for_select(@districts), prompt: "जिला चुने", 
                class: "form-control", 'data-target': 'misc.district', 
                'data-action': 'change->misc#getRecords' %>
            </div>
            <div class="col-md-3">
              <label class="form-label">Tehsil</label>
              <%= select_tag :tehsil, options_for_select([]), prompt: "तहसील चुने", class: "form-control", 'data-target': 'request.tehsil misc.tehsil', 'data-action': 'change->misc#getRecords' %>
            </div>
            <div class="col-md-3">
              <label class="form-label">Circle</label>
              <%= select_tag :circle, options_for_select([]), prompt: "सर्किल चुने", class: "form-control", 'data-target': 'request.circle misc.circle', 'data-action': 'change->misc#getRecords' %>
            </div>
            <div class="col-md-3">
              <label class="form-label">Village</label>
              <%= select_tag :request_village_id, options_for_select([]), prompt: "ग्राम चुने", class: "form-control set-pmkisan-data", 'data-target': 'request.village misc.village' %>
            </div>
          </div>
         </div>
      <% end %>
      <%= render partial: "blank_forms/forms/#{certificate_name(params[:department])}/#{certificate_name(@blank_form.section_eng)}/#{certificate_name(@blank_form.eng_name)}" %>
    </div>
    <div class="divider-bdr"></div>
  </div>
  <div class="col-md-1"></div>
</div>
<% content_for :head do %>
  <%= javascript_import_module_tag "custom/translate-custom" %>
<% end %>