<div class="letter-block" data-controller="blnk-frm">
  <span id="translatable" style="display:none;">
    <input id="input1" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="true"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>
  <span id="not-translatable" style="display:none;">
    <input id="input2" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="false"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>

  <div class="page-a4 only-print selection-criteria-block" id="pension-form-page1">
    <div class="col-md-12 mt-2">
      <div class="row padding-2">
        <div class="text-center fnt-24 fnt-b mb-2">
          कार्यालय <%= raw blank_string_format2(32, true, "office_name") %>
        </div>
        <div class="row fnt-17 mb-3 p-2">
          <div class="col-md-6">क्रमांक/_ _ _ _ _ </div>
          <div class="col-md-6"><span class="fRight">दिनांक _ _/_ _ /_ _ _ _</span></div>
        </div>
        <div class="paragraph-30 ln-hgt-28">
          प्रति,
          <div class="txt-indent-2">
            कोषालय अधिकारी
          </div>
          <div class="txt-indent-2 mb-3"> 
            जिला <%= raw blank_string_format2(8, true, "district") %>
          </div>
   
          <div class="txt-indent-2 fnt-24 fnt-b mb-5">
            बिषय : पेन्शन प्रकरण प्रस्तुत करने बाबत ।
          </div>
          महोदय,
          <div class="txt-indent-2">
            श्री/श्रीमती (नाम) <strong><%= raw blank_string_format2(32, true, "applicant") %></strong>
          </div>
          <div class="txt-indent-2 mb-3"> 
            सेवानिवृत्त/मृत्यु (पदनाम) <strong><%= raw blank_string_format2(28, true, "post_name") %></strong>
          </div>
          <div class="mb-2">पेन्शन प्रकरण सेवा पुस्तिका सहित प्रेषित है।</div>
          <div class="fnt-u mb-5">
            इस प्रकरण से सम्बन्धित अन्य आवश्यक जानकारी पृष्ठ के पीछे दी जा रही है।
          </div>
          <div class="row">
            <span class="offset-md-9 col-md-3 text-center fnt-b">
              <div>हस्ताक्षर/कार्यालय प्रमुख</div>
              <div>पद मुद्रा</div>
            </span>
          </div>
          <div class="fnt-b mb-2"><strong>संलग्न अभिलेखों की सूचीः-</strong></div>
          <div>
            सेवा पुस्तिका मूल संख्या <%= raw blank_string_format2(7, true, "service_book_number") %> वेतन निर्धारित पत्र <%= raw blank_string_format2(7, true, "salary_letter") %> अन्य सेवानस्ती पृष्ठ 1 से <%= raw blank_string_format2(7, true, "retirement_last_page") %>तक।
          </div>
          <ul>
            <li>फार्म क्रं. 1 - पेन्शन परिलब्धियों का स्वीकृति का प्रपत्र एक</li>
            <li>फार्म क्रं. 2 - पेन्शन परिलब्धियों का स्वीकृति का प्रपत्र दो</li></li>
            <li>फार्म क्रं. 3 - क्षतिपूर्ति बांड </li>
            <li>फार्म क्रं. 4 - कर्मचारी के संयुक्त छाया चित्र/हस्ताक्षर/कद एवं पहचान चिन्ह का फार्म</li>
            <li>फार्म क्रं. 5 - प्रपत्र तीन मृत्यु पर</li>
            <li>फार्म क्रं. 6 - प्रपत्र चार मृत्यु पर</li>
            <li>फार्म क्रं. 7 - आवेदक/नमूना हस्ताक्षर छायाचित्र</li>
            <li>फार्म क्रं. 8 - परिशिष्ट एक</li>
            <li>फार्म क्रं. 9 - फिप्थ शिड्यूल</li>
            <li>फार्म क्रं. 10 - लास्ट पे सर्टिफिकेट</li>
            <li>फार्म क्रं. 11 - घोषणा पत्र</li>
            <li>फार्म क्रं. 12 - नो डिमांड/नो इन्क्वायरी/नो इवेंट सर्टिफिकेट</li>
            <li>फार्म क्रं. 13 - थम्ब एण्ड फिगर इम्प्रेशन</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

