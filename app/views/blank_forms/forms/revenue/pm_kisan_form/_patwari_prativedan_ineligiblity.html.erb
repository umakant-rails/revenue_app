<div class="letter-block" data-controller="blnk-frm">
  <span id="translatable" style="display:none;">
    <input id="input1" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="true"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>
  <span id="not-translatable" style="display:none;">
    <input id="input2" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="false"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>

  <div class="page-a4 only-print selection-criteria-block" id="patwari-letter">
    <div class="col-md-12 ln-hgt-30">
      <div class="row">&nbsp;</div>
      <div class="row padding-5">
        <div class="fnt-26 fnt-b fnt-u mb-2">
          <center>
            <span class="karyalay-status">
              कार्यालय पटवारी हल्का नंबर <%= raw blank_string(4, false, 'halka_number')%>, तहसील <%= raw blank_string(6, false, 'tehsil')%>
            </span> 
          </center>
        </div>
      </div>
      <div class="row mrgn-top-10 padding-5">
        <div class="paragraph-30">
          प्रति,
          <div class="padding-5 fnt-b mb-3 addressing-office">
            तहसीलदार महोदय,<br/>
            तहसील <%= raw blank_string(6, false, 'tehsil')%>, जिला <%= raw blank_string(6, false, 'district')%>
          </div>
          <div class="mb-3 subject-status">
            <strong>विषय :-</strong> पी एम किसान योजना के अपात्र/मृत हितग्राहियो को पी एम किसान पोर्टल पर अपात्र दर्ज करने बाबत |
          </div>
          <div>महोदय,</div>
          <div class="txt-indent-2 mb-3">
            उपरोक्त विषयान्तर्गत श्रीमान जी से निवेदन है कि ग्राम <%= raw blank_string(15, true, 'village')%>, हल्का नंबर <%= raw blank_string(4, false, 'halka_number')%> के कुछ किसान पी एम किसान योजना के मापदंडो के अनुरूप विभिन्न कारणों से अपात्र पाए गए है, जिनको शासन की निर्देश अनुसार पी एम किसान पोर्टल पर अपात्र किया जाना है | उक्त सभी अपात्र किसानो को पी एम पोर्टल पर अपात्र किये जाने हेतु पी एम किसान योजना के अपात्र हितग्राहियो की जानकारी निम्नानुसार है : - 
          </div>
          <div class="mb-3">
            <table class="table table-bordered" id='my-data-table'>
              <thead>
                <tr style="vertical-align: middle;">
                  <th scope="scope" style="width: 18%;">रजिस्ट्रेशन नंबर</th>
                  <th scope="col" style="width: 30%;">हितग्राही का नाम</th>
                  <th scope="col" style="width: 40%;">अपात्रता का कारण</th>
                  <th scope="col" style="width: 12%;">अपात्रता की तिथि  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><%= raw blank_string(9, true, 'applicant')%></td>
                  <td><%= raw blank_string(16, false, 'registration_number')%></td>
                  <td><%= raw blank_string(22, false)%></td>
                  <td><%= raw blank_string(5, false)%></td>
                </tr>
                <tr>
                  <td><%= raw blank_string(9, true, 'applicant')%></td>
                  <td><%= raw blank_string(16, false, 'registration_number')%></td>
                  <td><%= raw blank_string(22, false)%></td>
                  <td><%= raw blank_string(5, false)%></td>
                </tr>
              </tbody>
            </table>
            <i class="fa-solid fa-circle-plus text-success fnt-24 hide-on-print add-row"></i>
            <i class="fa-solid fa-circle-minus text-danger fnt-24 hide-on-print remove-row"></i>
            <i class="fa-solid fa-circle-minus text-warning fnt-24 hide-on-print remove-row"></i>
          </div>
          <div class="txt-indent-2 mb-1">
            उक्त सूची पी एम किसान पोर्टल पर किसानो को अपात्र करने लिए  श्रीमान जी की ओर सादर प्रेषित है | 
          </div>
          <div class="">&nbsp;</div>
          <div class="fRight fnt-b mt-2 me-5">
            <center>
              <div class="sign-status">
                <div>पटवारी</div>
                <div>हल्का नंबर <%= raw blank_string(4, false, 'halka_number')%></div>
              </div>
            </center>
          </div>          
        </div>
      </div>
    </div>
  </div>
</div>