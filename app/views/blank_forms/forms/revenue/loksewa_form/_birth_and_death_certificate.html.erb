              <%= raw blank_string_format2(18, true, "panch1_address") %>
            </div>
            <div class="w-30">
              <%= raw blank_string_format2(12, true, "panch1_sign") %>
            </div>
          </div>
          <div class="roww mb-3">
            <div class="w-30">
              3.<%= raw blank_string_format2(12, true, "panch1") %>
            </div>
            <div class="w-40">
              <%= raw blank_string_format2(18, true, "panch1_address") %>
            </div>
            <div class="w-30">
              <%= raw blank_string_format2(12, true, "panch1_sign") %>
            </div>
          </div>
          <div class="roww mb-3">
            <div class="w-30">
              4.<%= raw blank_string_format2(12, true, "panch1") %>
            </div>
            <div class="w-40">
              <%= raw blank_string_format2(18, true, "panch1_address") %>
            </div>
            <div class="w-30">
              <%= raw blank_string_format2(12, true, "panch1_sign") %>
            </div>
          </div>
          <div class="roww mb-3">
