          <div class="roww mb-3">
            <div class="w-30 text-center fnt-b">नाम</div>
            <div class="w-40 text-center fnt-b">पिता का नाम एवं निवास</div>
            <div class="w-30 text-center fnt-b">हस्ताक्षर</div>
          </div>
          <div class="roww mb-3">
            <div class="w-30">
              1.<%= raw blank_string_format2(12, true, "panch1") %>
            </div>
            <div class="w-40">
              <%= raw blank_string_format2(18, true, "panch1_address") %>
            </div>
            <div class="w-30">
