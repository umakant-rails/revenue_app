<div class="birth-death-certificate-block" data-controller="blnk-frm">
  <span id="translatable" style="display:none;">
    <input id="input1" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="true"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>
  <span id="not-translatable" style="display:none;">
    <input id="input2" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="false"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>

  <div class="page-a4 only-print" id="khasra-copy-form">
    <div class="row">
      <div class="fnt-30 txt-center fnt-b fnt-u mt-2">
        प्रतिलिपि प्राप्त करने हेतु आवेदन पत्र
      </div>
      <div class="padding-8">
        प्रति,
        <div class="txt-indent-2">
          <div>श्रीमान प्रधान प्रतिलिपिकार महोदय</div>
          <div class="mb-3">
            कार्यालय कलेक्ट्रेट/तहसीलदार <%= raw blank_string(10, true, "tehsil") %>
          </div>
        </div>
        <table class="w-100 table-bordered mb-2">
          <%
            arr = ['विभाग', 'न्यायालय का नाम', 'ग्राम का नाम', 'पटवारी हल्का नम्बर', 'खसरा नम्बर', 'बंदोबस्त नम्बर', 'राजस्व निरीक्षक मण्डल', 'प्रकरण क्रमांक', 'आदेश', 'तह कार्यालय से भेजने का दिनांक', 'प्रतिलिपि जिनकी आवश्यकता है', 'कहॉं है', 'प्रतिलिपि किस लिये चाहिये', 'पक्षकार का नाम ', 'आवेदक का नाम']
          %>
          <% arr.each_with_index do | txt, index | %>
            <tr>
              <td class="w-10 p-3"><%= index + 1 %></td>
              <td class="w-35 p-3"><%= txt %></td>
              <% if index == 2 %>
              <td class="w-55 p-3">
                <%= raw blank_string(0, true, "village") %>
              </td>
              <% else %>
                <td class="w-55 p-3"></td>
              <% end %>
            </tr>
          <% end %>
        </table>

        <div class="roww mb-2">
          <div class="w-50"><%= raw blank_string(12, true, "tehsil") %></div>
        </div>
        <div class="roww mb-2">
          <div class="w-80">दिनांक <%= blank_string_text(10) %></div>
          <div class="w-20">हस्ताक्षर आवेदक</div>
        </div>
      </div>
    </div>
  </div>
</div>