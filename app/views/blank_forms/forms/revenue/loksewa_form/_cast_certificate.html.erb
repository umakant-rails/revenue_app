                  </div>
                </div>
              </li>
              <li>
                <div class="mb-3">आवेदक का विवरण </div>
                <div class="row fnt-blue mb-3"> 
                  <div class="w-30">
                    * आवेदक का पूरा नाम 
                  </div>
                  <div class="w-70 bdr-blue">
                    <%=raw blank_string_format2(40, true, 'applicant') %>
                  </div>
                </div>
                <div class="row fnt-blue mb-3"> 
                  <div class="w-30">
                    * आवेदक के पिता का पूरा नाम
                  </div>
                  <div class="w-70 bdr-blue">
                    <%=raw blank_string_format2(40, true, 'applicant_father_name') %>
                  </div>
                </div>
                <div class="row mb-3"> 
                  <div class="w-30">
