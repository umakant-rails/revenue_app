          <div class="w-15 fnt-b bdr-black p-2 text-white bg-black" >
            लोक सेवा केंद्र द्वारा भरा जावे 
          </div>
          <div class="w-85 bdr-black">
            <div>Registration No.-Rs/<%=raw blank_string_format2(13, false, 'reg_number1') %>/108/<%=raw blank_string_format2(13, false, 'reg_number2') %> / <%=raw blank_string_format2(6, false, 'reg_number3') %></div>
            <div>Target date - <%=raw blank_string_format2(10, false, 'target_date') %></div>
          </div>
          <div class="w-100 bg-blue fnt-15 fnt-b ps-2 pt-1 text-white bdr-blue">
