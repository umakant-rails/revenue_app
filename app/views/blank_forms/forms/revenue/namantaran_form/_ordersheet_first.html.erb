<div class="page-a4 only-print">
  <span id="translatable" style="display:none;">
    <input id="input1" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="true"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>
  <span id="not-translatable" style="display:none;">
    <input id="input2" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="false"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>

  <div class="row">
    <div class="fnt-18 fnt-b">
      <center>फार्म "अ"</center>
    </div>
    <div class="fnt-22 fnt-b txt-center">
      (परिपत्र दो-१ के कंडिका 6 देखिये)<br />
      राजस्व आदेश -पत्र (रेव्हेन्यू ऑर्डर शीट )
    </div>
    <div class="mt-4 p-0 col-md-12 fnt-15">
      <div>
        तहसीलदार <div class="i-block w-20" ><%= raw blank_string_format2(13, true, "tehsil") %></div> के न्यायालय में मामला क्रमांक_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _सन _ _ _ __ _ _ _ _ _ _ _ _
      </div>
      <div>
        विषय - <strong>नामांतरण बाबत</strong> _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ प्रकरण की श्रेणी _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ अ/६ वर्ष _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
      </div>

      <div>
        ग्राम- <div class="i-block w-25" ><%= raw blank_string_format2(16, true, "village") %></div> बंदोबस्त क्रमांक _ _ _ _ _ _ _ _ पटवारी ह क्र <div class="i-block w-10" ><%= raw blank_string_format2(5, true, "halka_number") %></div> तहसील <div class="i-block w-20" ><%= raw blank_string_format2(13, true, "tehsil") %></div> _ _
      </div>

      <div>
        कलेक्टर का क्रमांक _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ सन _ _ _ _ _ _ _ _ अनुविभागीय अधिकारी का क्रमांक _ _ _ _ _ __ _ _ _ सन_ _ _ __ _ _ _ _
      </div>

      <div>
        तहसीलदार का क्रमांक _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ सन _ _ _ _ _ _ _ _ _नायब तहसीलदार का क्रमांक _ _ _ _ _ _ _ _ _ _सन_ _ _ _ _ _ _ _ _
      </div>
    </div>
  </div>
  <div class="mt-3">
    <div class="row first-row">
      <div class="w-15 table-left-column">
        आदेश अथवा कार्यवाही की तारीख और स्थान 
      </div>
      <div  class="w-65 table-center-column">
        पीठासीन अधिकारी के हस्ताक्षर सहित आवेदन पत्र अथवा कार्यवाही 
      </div>
      <div  class="w-20 table-right-column ps-0 pe-0">
        जहाँ आवश्यक हो, पर्ची व वकीलों के हस्ताक्षर आदेशों के पालन करवाकर लिपिक के संक्षित हस्ताक्षर  और प्रकरण की तारिख 
      </div>
    </div>
    <div class="row seccond-row">
      <div class="w-15 table-left-column txt-center">1</div>
      <div class="w-65 table-center-column txt-center">2</div> 
      <div class="w-20 table-right-column txt-center">3</div>
    </div>
    <div class="row pb-2">
      <div class="w-15 table-left-column"></div>
      <div class="w-65 table-center-column">
        <div class="m-sm-2 paragraph">
          <div class="txt-indent-2">
            आवेदक/आवेदिका <%= raw blank_string_format2(20, true, "applicant") %>
            पिता/पति <%= raw blank_string_format2(30, true, "applicant_father_name") %>
            निवासी <%= raw blank_string_format2(30, true, "applicant_address") %>
            द्वारा मौजा <%= raw blank_string_format2(15, true, "village") %> पटवारी हल्का न <%= raw blank_string_format2(6, true, "halka_number") %>
            में स्थित भूमि खसरा नम्बर <%= raw blank_string_format2(20, false, "khasra_number") %>
            में से रकबा <%= raw blank_string_format2(10, false, "rakba") %> आवेदक द्वारा रजिस्टर्ड
            बैनामा क्रमांक <%= raw blank_string_format2(12, false, "registry_number") %> दिनांक <%= raw blank_string_format2(10, false, "registry_date") %>
            के आधार पर नामांतरण कराये जाने बाबत आवेदन पेश किया है | 
          </div>
          <div class="row">
            <div>1 . प्रकरण दर्ज हो | </div>
            <div>2 . हल्का पटवारी से रिपोर्ट ली जाये | </div>
            <div>3 . इश्तहार  का प्रकाशन हो | </div>
            <div>4 . अनावेदक आहूत  हो | </div>
          </div>

          <div class="mrgn-top-20">&nbsp;</div>
     
          <div class=" mt-5">
            <p class="fLeft"><strong>पेशी</strong></p> 
            <p class="fRight"><strong>तहसीलदार/नायब तहसीलदार</strong></p>
          </div>
        </div>
      </div> 
      <div class="w-20 table-right-column"></div>
    </div>
  </div>
</div>