<!-- talwana patra -->
<div class="page-a4 only-print talwana">
  <span id="translatable" style="display:none;">
    <input id="input1" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="true"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>
  <span id="not-translatable" style="display:none;">
    <input id="input2" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="false"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>

  <div class="row">
    <div class="fnt-28 fnt-b fnt-u">
      <center>तलवाना</center>
    </div>
  </div>
  <br/>
  <div class="row">
    <div class="paragraph padding-8 ">
      <div class="row">
        <div class="col-md-3">न्यायालय श्रीमान</div><div class="col-md-9"> <%= raw blank_string_format2(32, true, "office_name") %></div>
        <div><center><strong>विरुद्ध</strong></center></div>
        <div class="col-md-3">वादी</div><div class="col-md-9"> <%= raw blank_string_format2(32, true, "applicant") %></div>
        <div class="col-md-3">प्रतिवादी</div><div class="col-md-9"> <%= raw blank_string_format2(32, true, "non_applicant") %></div>
      </div>
    </div>
    <div class="mrgn-top-20">&nbsp;</div>
    <div class="mrgn-top-10">&nbsp;</div>
    <div class="padding-4 mb-2 fnt-18">
      <div class="">
        <div class="fLeft">
          तलवाना कोर्ट फीस जारी होने के मुव. 
        </div>
        <div class="fRight">
          रु. का चस्पा है 
        </div>
      </div>
    </div>
    <div class="padding-4">
      <table class="talwana-table">
        <tbody>
          <tr>
            <td class="column12">क्रमांक</td>
            <td class="column25">नाम उस शख्स का जिस पर समन्स वगैरह तामीली होना है</td>
            <td class="column15">सकूनत जहाँ पर कागजात तामीली को भेजा जाता है</td>
            <td class="column12">तहसील</td>
            <td class="column12">क़िस्त तलवाना</td>
            <td class="column12">तादाद कोर्ट फीस</td>
            <td class="column12">कैफियत</td>
          <tr>
          <tr>
            <td class="column12">(1)</td>
            <td class="column25">(2)</td>
            <td class="column15">(3)</td>
            <td class="column12">(4)</td>
            <td class="column12">(5)</td>
            <td class="column12">(6)</td>
            <td class="column12">(7)</td>
          <tr>
          <tr>
            <td class="column12" style="height: 430px;"></td>
            <td class="column25"></td>
            <td class="column15"></td>
            <td class="column12"></td>
            <td class="column12"></td>
            <td class="column12"></td>
            <td class="column12"></td>
          <tr>
        </tbody>
      </table>
    </div>
    <div class="mrgn-top-20">&nbsp;</div>
    <div class="mrgn-top-10">&nbsp;</div>
    <div class="padding-5">
      <div class="row">
        <div class="fLeft col-md-3">तारीख</div>
        <div class="fLeft col-md-3">माह</div>
        <div class="fLeft col-md-3">सन</div>
        <div class="fLeft col-md-3">दस्तखत</div>
      </div>
    </div>
  </div>
</div>