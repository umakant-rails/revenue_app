                  </tr>
                  <tr>
                    <td>4.</td>
                    <td></td>
                    <td></td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="">
              4. पक्षकारो का विवरण जिन्हें नोटिस तामील नहीं हो सका 
            </div>
            <div class="seemankan-tbl pt-2">
              <table style="width:100%;">
                <thead>
                  <tr>
                    <th style="width:10%;">स क्र</th>
                    <th style="width:30%;">नाम</th>
                    <th style="width:60%;">नोटिस की तामील न होने के कारण</th>
                  </tr>
                  <tr>
                    <th>(1)</th>
                    <th>(2)</th>
                    <th>(3)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>1.</td>
                    <td></td>
                    <td></td>
                  </tr>
                  <tr>
                    <td>2.</td>
                    <td></td>
                    <td></td>
                  </tr>
                  <tr>
                    <td>3.</td>
                    <td></td>
                    <td></td>
                  </tr>
                  <tr>
                    <td>4.</td>
                    <td></td>
                    <td></td>
                  </tr>
                </tbody>
              </table>
            </div> 
          </div>
        </div>
      </div>
    </div>
  </div>

