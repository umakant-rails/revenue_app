            </div>
            <div class="ps-1">
              <ol class="mb-0">
                <li>
                  सीमांकन के क्रियान्वयन की तारिख <%= raw blank_string_format2(10, false, "date") %>
                </li>
                <li>
                  सीमांकन शुरू होने के समय <%= raw blank_string_format2(10, false, "starting_time") %> सीमांकन समाप्त होने का समय <%= raw blank_string_format2(10, false, "end_time") %>
                </li>
                <li>
                  सीमांकन के नोटिस का विवरण हितबद्ध पक्षकारो को दिये
                </li>
              </ol>
            </div>
            <div class="">
              3 . हितबद्ध पक्षकारो को दिए गए सीमानकन के नोटिस का विवरण 
            </div>
            <div class="seemankan-tbl pt-2 mb-3">
              <table style="width:100%;">
                <thead>
                  <tr>
                    <th style="width:10%;">स क्र</th>
                    <th style="width:30%;">नाम</th>
                    <th style="width:60%;">नोटिस की तामीली का प्रकार तथा तारीख</th>
                  </tr>
                  <tr>
                    <th>(1)</th>
                    <th>(2)</th>
                    <th>(3)</th>
                  </tr>
                </thead>
