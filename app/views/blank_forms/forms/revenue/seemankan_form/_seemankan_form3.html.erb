<div class="letter-block" data-controller="blnk-frm">
  <span id="translatable" style="display:none;">
    <input id="input1" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="true"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>
  <span id="not-translatable" style="display:none;">
    <input id="input2" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="false"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>

  <div class="page-a4 only-print selection-criteria-block" id="seemankan-praroop3-page-1">
    <div class="row padding-5 mt-3">
      <div class="paragraph-28">
        <div class="mt-1">
          <div class="fnt-15 fnt-b">
            <center>
              प्रारूप-तीन 
            </center>
            <center>
              (नियम  5 देखिये )
            </center>
          </div>
          <div class="fnt-15 fnt-b">
            <center>
              सीमांकन दल की रिपोर्ट
            </center>
          </div>
          <div class="mb-5">
            <div class="fRight">
              <strong>राजस्व प्रकरण क्रमांक</strong> <%= raw blank_string_format2(12, false, "case_number") %>
            </div>
          </div>
          <div>
            न्यायलय उपखण्ड अधिकारी, उपखण्ड <%= raw blank_string_format2(8, false, "anubhag") %> तहसील <%= raw blank_string_format2(8, false, "tehsil") %> जिला <%= raw blank_string_format2(8, false, "ddistrict") %> मध्यप्रदेश
          </div>
        </div>
        <div class="paragraph-28 mt-2">
          <div class="txt-indent-2">
            तारीख <%= raw blank_string_format2(10, false, "date") %> सीमांकन रिपोर्ट 
          </div>
