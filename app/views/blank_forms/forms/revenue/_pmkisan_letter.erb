                  <th scope="col">समग्र आई डी</th>
                  <th scope="col">बैंक अकाउंट एवं आई एफ एस सी कोड</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><%= raw blank_string(25, true, 'applicant')%></td>
                  <td><%= raw blank_string(12, false, 'registration_number')%></td>
                  <td><%= raw blank_string(12, false)%></td>
                  <td><%= raw blank_string(12, false)%></td>
                  <td><%= raw blank_string(12, false)%></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="txt-indent-2 mb-5">
            अतः श्रीमान जी से उक्त हितग्राही के सम्बन्ध में  निवेदन है कि हितग्राही <%= raw blank_string(25, true, 'applicant')%> को पी एम् किसान पोर्टल पर पात्र दर्ज करने की कष्ट करे, जिससे कि हितग्राही को पी एम किसान सम्मान निधि का लाभ प्राप्त हो सके |
          </div>
          <div class="fRight fnt-b mt-2 me-5">
            <center>
              <div class="sign-status">
                <div>तहसीलदार </div>
                <div><%= raw blank_string(5, false, 'tehsil')%></div>
              </div>
            </center>
          </div>          
        </div>
      </div>
    </div>
  </div>

