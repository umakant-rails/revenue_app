<!-- fouti application form -->
<div class="page-a4 only-print">
  <span id="translatable" style="display:none;">
    <input id="input1" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="true"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>
  <span id="not-translatable" style="display:none;">
    <input id="input2" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="false"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>

  <div class="col-md-12 halka-patwari-prativedan-pdf">
    <div class="row mrgn-top-20 mrgn-4">
      <div class="paragraph-35">
        <div class="">प्रति,<br/></div>
        <div class="txt-indent-2">
          श्रीमान तहसीलदार/नायब तहसीलदार महोदय <%= raw blank_string_format2(12, true, "tehsil") %>
        </div>
        <div class="txt-indent-2">
          वृत्त:- <%= raw blank_string_format2(14, true, "circle") %> तहसील <%= raw blank_string_format2(14, true, "tehsil") %>
        </div>
        <div class="">
          <strong>विषय &nbsp;:- </strong> फौती / नामांतरण वाबत |<br/>
        </div>
        <div class="">
          महोदय  जी,
        </div>
        <div class="paragraph-35">
          <div class="txt-indent-2">
            विनम्र निवेदन है कि  मैं <%= raw blank_string_format2(20, true, "applicant") %> पिता/पति <%= raw blank_string_format2(20, true, "applicant_father_name") %> निवासी ग्राम <%= raw blank_string_format2(20, true, "village") %> पटवारी हल्का न <%= raw blank_string_format2(4, false, "halka_number") %> का निवासी हूँ और मौजा <%= raw blank_string_format2(16, true, "village") %> पटवारी हल्का न <%= raw blank_string_format2(4, false, "halka_number") %> रा नि म <%= raw blank_string_format2(16, true, "circle") %> तहसील <%= raw blank_string_format2(16, true, "tehsil") %> में मेरे पिता/माता/भाई <%= raw blank_string_format2(20, true, "dead_person") %> के नाम पर भूमि खसरा नंबर <%= raw blank_string_format2(20, true, "khasra") %> रकबा <%= raw blank_string_format2(20, true, "khasra_rakba") %> हे. कुल रकबा <%= raw blank_string_format2(10, true, "rakba") %> हे. है, जो कि दिनांक <%= raw blank_string_format2(10, true, "death_date") %> को फौत हो चुके है जिनके वैध वारसान निम्न संजारा अनुसार है :-
          </div>
          <div>
            <table class="table fnt-18">
              <thead>
                <tr>
                  <td colspan="3" class="fnt-20">
                    <center><span class="fnt-b">संजरा</span> ( <%= raw blank_string_format2(16, true, "dead_person") %> )</center>
                  </td>
                </tr>
              </thead>
              <tbody>
                <tr scope="row">
                  <th style="width:33%;text-align: left;">पुत्र</th>
                  <th style="width:33%;text-align: center;">पुत्री</th>
                  <th style="width:33%;text-align: right;">पत्नी/बेवा</th>
                </tr>
                <tr scope="row" style="height: 250px;">
                  <td colspan="3"style="border-bottom: 0px;">
                    &nbsp;
                  </td>
                </tr>
              </tbody>
            </table>
            <br/>
            उपरोक्त संजरा में उल्लिखित वारिसों के अलावा कोई अन्य वारसान नहीं है यदि भविष्य में कोई दावा करता है और ऐसी पुष्टि होती है तो मैं स्वयं व्यक्तिगत रूप से जिम्मेदार माना जाउगा अन्य कोई नहीं |  <br/> 
          </div>
        </div>
        <div class="">&nbsp;</div>
        <div class="paragraph-30">
          <div class="fLeft">
            <div>&nbsp;</div>
            <div class="fLeft">दिनांक :- <%= format_dt(Date.today)%></div>
          </div>
          <div class="fRight fnt-b">
            <center>आवेदक</center>
            <center>नाम _ _ _ _ _ _ _ _ _ _ _ _पिता/पति_ _ _ _ _ _ _ _ _ _ _ _</center>
            <center>निवासी :-_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ </center>
          </div>
        </div> 
      </div>
    </div>
  </div>
</div>