<!-- ishthaar patra -->

<div class="page-a4 only-print">
  <span id="translatable" style="display:none;">
    <input id="input1" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="true"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>
  <span id="not-translatable" style="display:none;">
    <input id="input2" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="false"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>

  <div class="col-md-12">
    <div class="row">
      <div class="fnt-28 fnt-b txt-center">
        समक्ष न्यायालय श्रीमान तहसीलदार महोदय, <%= raw blank_string_format2(8, true, "tehsil") %>
      </div>
    </div>
    <div class="row mrgn-2 mrgn-top-18">
       <div>&nbsp;</div>
      <div class="fnt-20 mrgn-4">
        <div class="row">
          <div class="col-md-3 fnt-b">राजस्व प्र. क्र.</div>
          <div class="col-md-9"><%= raw blank_string(24, false, "prakran_kriamank") %></div>
        </div>
        <div class="row">
          <div class="col-md-3 fnt-b">ग्राम का नाम</div>
          <div class="col-md-9"><%= raw blank_string(24, true, "village") %></div>
        </div>
        <div class="row">
          <div class="col-md-3 fnt-b">पटवारी हल्का नंबर</div>
          <div class="col-md-9"><%= raw blank_string(24, false, "halka_number") %></div>
        </div>
        <div class="row">
          <div class="col-md-3 fnt-b">रा नि मंडल</div> 
          <div class="col-md-9"><%= raw blank_string(24, true, "circle") %></div>
        </div>
      </div>
      <div class="fnt-30 mrgn-top-20">
        <center>"इश्तहार"</center>
      </div>
      <div class="paragraph mrgn-top-20 ">
        <div class="txt-indent-3">
          सर्व साधारण एवं ग्राम पटवारी हल्का पटवारी नंबर <%= raw blank_string_format2(4, false, "halka_number0") %> रा नि मंडल <%= raw blank_string_format2(20, true, "circle") %> तहसील <%= raw blank_string_format2(16, true, "tehsil") %> जिला <%= raw blank_string_format2(20, true, "district") %> की आम जनता के जरिये इश्तिहार के सूचित किया जाता है कि - <br/>
          आवेदक <%= raw blank_string_format2(24, true, "applicant") %> पिता/पति <%= raw blank_string_format2(24, true, "applicant_father_name") %> निवासी <%= raw blank_string_format2(16, true, "applicant_address") %> द्वारा मौजा <%= raw blank_string_format2(12, true, "village") %> की भूमि खसरा नंबर <%= raw blank_string_format2(16, false, "khasra") %> रकबा <%= raw blank_string_format2(10, false, "rakba") %> वर्ग फु/हे भूमि का नामांतरण <strong>फौती</strong> के आधार पर कराने हेतु आवेदन प्रस्तुत किया है | <br/>
        </div>
        <div class="txt-indent-3">
          उक्त संबंध में जिस किसी भी व्यक्ति को कोई आपत्ति हो तो वह अपनी आपत्ति अथवा आवेदन पत्र पेशी दिनांक <%= raw blank_string_format2(10, false, "prakaran_date") %> तक इस न्यायलय में उपस्थित होकर स्वयं अथवा माननीय अधिवक्ता के द्वारा प्रस्तुत कर सकते है | <br/>
        </div>
        <div class="txt-indent-3">
          गुजरने मियाद किसी भी आपत्ति अथवा आवेदन पत्र पर विचार नहीं किया जायेगा स्थान मेरे हस्ताक्षर एवं न्यायलय की मुद्रा एवं मुहर से दिनांक <%= raw blank_string_format2(10, false, "prakaran_date") %> को जारी किया गया|
        </div>
        <div class="mrgn-top-20">&nbsp;</div>
        <div class="mrgn-top-10">&nbsp;</div>
        <div class="">
          <div class="fRight">
            <center>
              <strong>तहसीलदार/नायब तहसीलदार</strong>
            <center>
            <center>
              <strong>वृत्त - <%= raw blank_string_format2(8, true, "circle") %> </strong>
            </center>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
