<!-- halka patwari prativedan -->

<div class="page-a4 only-print">
  <span id="translatable" style="display:none;">
    <input id="input1" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="true"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>
  <span id="not-translatable" style="display:none;">
    <input id="input2" name="inputText" type="text" value="" 
      class="hidden-field" data-blnk-frm-target="textField" data-translatable="false"
      data-action="keydown.tab->blnk-frm#nextInput keydown.enter->blnk-frm#typingText" />
  </span>

  <div class="col-md-12 halka-patwari-prativedan-pdf">
    <div class="row">
      <div class="fnt-24 fnt-b fnt-u">
        <center>
          कार्यालय पटवारी हल्का नंबर <%= raw blank_string_format2(4, false, "halka_number") %>, तहसील <%= raw blank_string_format2(10, true, "tehsil") %>
        </center>
      </div>
    </div>
    <div class="row mrgn-top-30 mrgn-4">
      <div class="paragraph">
        <div class="">प्रति,<br/></div>
        <div class="pd-left-8">
          श्रीमान तहसीलदार/नायब तहसीलदार महोदय <br/>
          वृत्त <%= raw blank_string_format2(10, false, "circle") %> तहसील <%= raw blank_string_format2(10, false, "tehsil") %>
        </div><br/>
        <div class="">
          <strong>विषय &nbsp;:- </strong> फौती नामांतरण के सम्बन्ध में |<br/>
          <!-- <strong>सन्दर्भ :-</strong> श्रीमान जी के आदेश दिनांक _ _ _ _ _ _ _ _ _ के परिपालन के सम्बन्ध में |<br/><br/> -->
        </div>
        <div class="">
          महोदय  जी,<br/>
        </div>
        <div class="paragraph-30">
          <div class="txt-indent-2">
            उपरोक्त विषयान्तर्गत लेख है कि आवेदक <%= raw blank_string_format2(24, true, "applicant") %> पिता <%= raw blank_string_format2(24, true, "applicant_father_name") %>  जाति <%= raw blank_string_format2(16, true, "applicant_cast") %> निवासी <%= raw blank_string_format2(24, true, "applicant_address") %>  के द्वारा अपने माता/पिता की मृत्यु दिनांक <%= raw blank_string_format2(10, false, "death-date") %> को हो जाने से नामांतरण/फौती हेतु आवेदन पत्र श्रीमान जी के समक्ष प्रस्तुत  किया है  <br/> 
          </div>
          <div class="txt-indent-2">
            यह है कि, मौजा <%= raw blank_string_format2(16, true, "village") %> पटवारी हल्का नंबर <%= raw blank_string_format2(4, false, "halka_number") %>  में स्थित खसरा नंबर <%= raw blank_string_format2(20, false, "khasra") %>  रकबा <%= raw blank_string_format2(10, false, "rakba") %> हे वर्तमान अभिलेख में <%= raw blank_string_format2(20, true, "dead_person") %> पिता <%= raw blank_string_format2(16, true, "dead_person_father_name") %> निवासी <%= raw blank_string_format2(16, true, "dead_person_address") %>  के नाम दर्ज है |
          </div>
          <div class="txt-indent-2 mb-3">
            यह कि, पंचनामा मुताबिक  मृतक <%= raw blank_string_format2(20, true, "dead_person") %> पिता <%= raw blank_string_format2(16, true, "dead_person_father_name") %> के वारिसों के नाम निम्न संजरा अनुसार है :- 
          </div>
          <div class="">
            <table class="table fnt-18">
              <thead>
                <tr>
                  <td colspan="3" class="fnt-20">
                    <center><span class="fnt-b">संजरा</span> ( _ _ _ _ _ _ _ _ _ _ _ _)</center>
                  </td>
                </tr>
              </thead>
              <tbody>
                <tr scope="row">
                  <th style="width:33%;text-align: left;">पुत्र</th>
                  <th style="width:33%;text-align: center;">पुत्री</th>
                  <th style="width:33%;text-align: right;">पत्नी/बेवा</th>
                </tr>
                <tr scope="row" style="height: 150px;">
                  <td colspan="3"style="border-bottom: 0px;">
                    &nbsp;
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="txt-indent-2">
            अतः श्रीमान जी के समक्ष प्रतिवेदन सादर सम्प्रेषित है |
          </div>
        </div>
        <div class="mrgn-top-10">&nbsp;</div>
        <div>
          <div class="fRight">
            <center>_ _ _ _ _ _ _ _ _ _ _ _ _ _</center>
            <center><strong>हस्ताक्षर</strong></center>
            <center><strong>पटवारी हल्का</strong> <%= raw blank_string_format2(4, false, "halka_number") %></center>
          </div>
        </div> 
      </div>
    </div>
  </div>
</div>
