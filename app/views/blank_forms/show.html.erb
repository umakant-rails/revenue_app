<div class="row pt-4" data-controller="request">
  <div class="col-md-1"></div>
  <div class="col-md-3 not-print">
    <div class="row page-list">
      <div class="page-header">
        पेज की सूची
      </div>
      <ol class="list-group mb-4 pe-0 page-list" data-request-target="paymentstatus">
        <% @blank_forms && @blank_forms.each do | blank_form | %>
          <%= link_to show_blank_forms_path(params[:department], blank_form.id), class: "text-decoration-none" do %>
            <% active_cls = (blank_form.eng_name == @blank_form.eng_name) ? "active" : "" %>
            <li class="list-group-item <%= active_cls %>" data-action="click->request#showPage" data-pagename="request-page">
              <%= blank_form.hindi_name %>
            </li>
          <% end %>
        <% end %>
      </ol>
    </div>
    <div class="row">
      <div class="col-md-6">
        <input type="button" value="print" class="form-control btn btn-primary mt-2 print-btn" />
      </div>
      <div class="col-md-6">
        <button data-action="click->blnk-frm#downloadPDF" class="form-control btn btn-danger mt-2" />
          PDF&nbsp;&nbsp;<i class="fa-solid fa-file-export"></i>
        </button >
      </div>
    </div>
  </div>
  <div class="col-md-7 ms-5" data-controller="blnk-frm">
    <div id="page-block">
      <%= render partial: "blank_forms/forms/#{params[:department]}/#{certificate_name(@blank_form.section)}/#{certificate_name(@blank_form.eng_name)}" rescue nil %>
    </div>
    <div class="divider-bdr"></div>
  </div>
  <div class="col-md-1"></div>
</div>
<% content_for :head do %>
  <%= javascript_import_module_tag "custom/translate-custom" %>
<% end %>