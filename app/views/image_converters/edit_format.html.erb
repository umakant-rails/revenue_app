<div class="row" data-controller="image">
  <div class="col-md-2"></div>
  <div class="col-md-8">
    <div class="row">
      <div class="col-md-12 txt-center page-header mb-3">
        Change Your Image Format (.jpg, jpeg, .png, .webm etc)
      </div>
    </div>
    <%= form_tag(update_format_image_converters_path, method: :post, multipart: :true) do  %>
      <div class="row">
        <div class="col-md-9">
          <input type="file" name ="image" id="select_image" data-image-target="selectedFile" 
            accept="image/*" class="form-control mb-3" 
            data-action="change->image#displayImage"/>
        </div>
        <div class="col-md-3">
          <select name="img_format" class="form-control">
            <option value="">Select Format</option>
            <option value="png">PNG</option>
            <option value="jpeg">JPG/JPEG</option>
            <option value="gif">GIF</option>
            <option value="bmp">BMP</option>
            <option value="webp">WEBP</option>
          </select>
        </div>
      </div>
      <div class="row">
        <div class="col-md-9">
          <div id="result" class="mb-3 hide" data-image-target="selectedImage" style="height: 600px;">
          </div>
        </div>
      </div>
      <div class="row mb-3">
        <div class="col-md-3">
          <button type="submit" class="btn btn-primary form-control update-format date hide" data-image-target="formatUpdationBtn">Update Format</button>
        </div>
      </div>
    <% end %>

  </div>
  <div class="col-md-2"></div>
</div>

