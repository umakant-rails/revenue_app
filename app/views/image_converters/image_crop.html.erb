<div class="row" data-controller="image dragndrop">
  <div class="col-md-2"></div>
  <div class="col-md-8">
    <div class="row">
      <div class="col-md-12 txt-center page-header mb-3">
        Crop Your Image
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <input type="file" id="select_image" data-image-target="selectImage" accept="image/*" 
         class="form-control mb-3" data-action="change->image#selectToImage"/>
      </div>
    </div>
    <div class="row">
      <div class="col-md-9">
        <div id="result" class="mb-3 hide" data-image-target="selectedImage" style="height: 600px;">
        </div>
      </div>
      <div class="col-md-3" data-image-target="croppedImages" style="height: 600px;overflow-y:auto;"></div>
    </div>
    <div class="row mb-3">
      <div class="col-md-3">
        <button class="btn btn-primary form-control save hide" data-image-target="saveBtn" data-action="click->image#cropToImage">Save</button>
      </div>
    </div>
  </div>
  <div class="col-md-2"></div>
</div>


