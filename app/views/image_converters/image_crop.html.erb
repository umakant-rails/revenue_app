<div class="row" data-controller="image">
  <div class="col-md-2"></div>
  <div class="col-md-8">
    <div class="row">
      <div class="col-md-3">
        <div class="page-header mb-3">
          फोन्ट रूपांतरण सूची
        </div>
        <ul class="list-group">
          <%= link_to image_to_text_image_converters_path, class: "anchor-no-decoration" do %>
            <li class="list-group-item">
              Get Text From Image
            </li>
          <% end %>
          <li class="list-group-item active">
            Crop Image
          </li>
          <li class="list-group-item">
            Change Image Format
          </li>
        </ul>
      </div>
      <div class="col-md-9">
        <div class="col-md-12 txt-center page-header mb-3">
          Crop Your Image
        </div>
        <input type="file" name="select_image" data-image-target="selectImage" accept="image/*" 
          class="form-control mb-3" data-action="change->image#selectToImage"/>
        <hr>
        <div id="result" class="mb-3 hide" data-image-target="selectedImage" style="height: 600px;">
        </div>
        <div class="row mb-3">
          <div class="col-md-3">
            <button class="btn btn-primary form-control save hide" data-image-target="saveBtn" data-action="click->image#cropToImage">Save</button>
          </div>
        </div>
        <div class="row mb-3" data-image-target="croppedImages">
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-2"></div>
</div>


