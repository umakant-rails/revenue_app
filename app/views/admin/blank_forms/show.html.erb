<div class="row">
  <div class="col-md-3"></div>
  <div class="col-md-6">
    <div class="row">
      <div class="page-header mb-4">
        फॉर्म विवरण 
      </div>
      <div class="mb-3 row pe-0">
        <div class="col-md-6">
          <div class="label-hdr mb-2">विभाग (हिंदी)</div>
          <div class="ms-1">
            <%= @blank_form.department.hindi_name.capitalize %>
          </div>
        </div>
        <div class="col-md-6 pe-0">
          <div class="label-hdr mb-2">विभाग (अंग्रेजी)</div>
          <div class="ms-1">
            <%= @blank_form.department.eng_name.capitalize %>
          </div>
        </div>
      </div>
      <div class="mb-3">
        <div class="label-hdr mb-2">फॉर्म नाम (अंग्रेजी)</div>
        <div class="ms-1">
          <%= @blank_form.eng_name %>
        </div>
      </div>

      <div class="mb-3">
        <div class="label-hdr mb-2">फॉर्म नाम (हिंदी)</div>
        <div class="ms-1">
          <%= @blank_form.hindi_name %>
        </div>
      </div>

      <div class="mb-3">
        <div class="label-hdr mb-2">फॉर्म श्रेणी (अंग्रेजी)</div>
        <div class="ms-1">
          <%= @blank_form.section_eng %>
        </div>
      </div>
      <div class="mb-3">
        <div class="label-hdr mb-2">फॉर्म श्रेणी (हिंदी)</div>
        <div class="ms-1">
          <%= @blank_form.section_hindi %>
        </div>
      </div>
    </div>
    <hr>
    <div>
      <%= link_to "Edit Form", edit_admin_blank_form_path(@blank_form), class: "anchor-no-decoration btn btn-primary" %> 
      <%= link_to "Form List", admin_blank_forms_path, class: "anchor-no-decoration btn btn-primary"  %> 
      <%= button_to("Delete Form", admin_blank_form_path(@blank_form), method: :delete, :class => "btn  btn-danger anchor-no-decoration", form_class: 'btn ps-0 pe-0 ') %>
    </div>
  </div>
  <div class="col-md-3"></div>
</div>