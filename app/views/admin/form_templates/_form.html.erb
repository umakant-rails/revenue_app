<%= form_with(model: [:admin, form_template]) do |form| %>
  <div class="mb-3" data-controller="request">
    <% if form_template.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(form_template.errors.count, "error") %> prohibited this order template from being saved:</h2>

        <ul>
          <% form_template.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="row mb-3">
      <div class="col-md-2"></div>
      <div class="col-md-3">
        <%= form.select :category, options_for_select(FormTemplate::CATEGORIES), {prompt: 'Select Category'}, class: "form-control" %>
      </div>
      <div class="col-md-3">
        <%= form.text_field :name, class: "form-control" %>
      </div>
      <div class="col-md-2">
        <%= form.submit class: "btn btn-primary" %>
      </div>
      <div class="col-md-2"></div>
    </div>
    <div class="row">
      <div class="col-md-5 p-0 ms-5">
        <center>
          <%= form.text_area :template, class: 'tinymce', style: "width:100%;height:29.7cm;", 'data-action': 'keyup#setOrderContent change#setOrderContent'%>
        </center>
      </div>
      <div class="col-md-6">
        <div class="page-a4">
        <div class="order_details padding-5" style="min-height:100px;">
          
        </div>
        </div>
      </div>
    </div>
  </div>
<% end %>